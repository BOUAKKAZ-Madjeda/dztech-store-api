PORT=3000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_local_secret
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:5173

# Comma-separated emails that get the "seller" role (all other accounts are customers)
SELLER_EMAILS=seller@example.com

# Optional: OAuth 2.0 / OpenID Connect (e.g. Auth0)
OAUTH_ISSUER=
OAUTH_JWKS_URI=
OAUTH_AUDIENCE=
